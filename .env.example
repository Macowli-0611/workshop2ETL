# ==============================================================
# Workshop-2 ETL — environment variables
# Copy to .env and set real values:   cp .env.example .env
# Never commit .env (it is git-ignored).
# ==============================================================

# PostgreSQL (source DB, Data Warehouse, Airflow metadata, Metabase metadata)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost        # host-side scripts; containers use the service name "postgres"
POSTGRES_PORT=5432

SOURCE_DB_NAME=source_music_db
DW_DB_NAME=dw_music_analytics

# Host ports (change them if already in use on your machine)
AIRFLOW_PORT=8080
METABASE_PORT=3000

# Airflow image user
AIRFLOW_UID=50000

# Metabase admin created by scripts/setup_metabase.py (local only)
MB_ADMIN_EMAIL=admin@example.local
MB_ADMIN_PASSWORD=change_me_too

# BI publication for Looker Studio (cloud PostgreSQL, e.g. Neon free tier)
# Owner connection string of the cloud database (keep sslmode=require)
BI_DW_URL=postgresql://owner:change_me@ep-example.us-east-2.aws.neon.tech/dw_music_analytics?sslmode=require
BI_READER_USER=bi_reader
BI_READER_PASSWORD=change_me_reader
