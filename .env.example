# ==============================================================
# Variables de Entorno del Proyecto - Workshop-2 ETL
# Copia este archivo como .env y ajusta los valores si es necesario.
# NUNCA subas el archivo .env real con contraseñas a Git.
# ==============================================================

# Configuración de Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Nombres de bases de datos
SOURCE_DB_NAME=source_music_db
DW_DB_NAME=dw_music_analytics
AIRFLOW_DB_NAME=airflow_db

# Configuración de Apache Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.8-python3.11
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False

# Configuración de Rutas de Datos
DATA_DIR=/opt/airflow/data
SPOTIFY_CSV_PATH=/opt/airflow/data/spotify_dataset.csv
GRAMMY_CSV_PATH=/opt/airflow/data/the_grammy_awards.csv
